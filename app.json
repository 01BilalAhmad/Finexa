{
  "expo": {
    "name": "Finexa",
    "slug": "finexa-recovery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "finexa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Finexa needs your location to track your route and detect shop visits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Finexa needs background location to track your route even when the app is minimized."
      }
    },
    "android": {
      "package": "com.alfalahtraders.finexa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Finexa needs your location to track your route and detect shop visits.",
          "locationAlwaysAndWhenInUsePermission": "Finexa needs background location to track your route even when the app is minimized."
        }
      ],
      [
        "expo-task-manager"
      ],
      [
        "expo-notifications"
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b3b6cb0-3941-401c-8c52-e57293ed4760"
      }
    },
    "owner": "alfalahtraders"
  }
}
